@model WeatherAPI.Models.WeatherResponse
@{
    ViewData["Title"] = "Tra cứu thời tiết";
}

<div class="text-center">
    <h1 class="display-4">Dự Báo Thời Tiết</h1>

    <form asp-action="Index" method="post" class="mt-4">
        <input type="text" name="city" placeholder="Nhập tên thành phố (VD: Hanoi)" class="form-control w-50 mx-auto d-inline" />
        <button type="submit" class="btn btn-primary">Tìm kiếm</button>
    </form>

    <div class="mt-5">
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        @if (Model != null)
        {
            <div class="card w-50 mx-auto shadow">
                <div class="card-body">
                    <h2>@Model.Name</h2>
                    <img src="https://openweathermap.org/img/wn/@(Model.Weather[0].Icon)@@2x.png" alt="icon" />
                    <h1>@Model.Main.Temp °C</h1>
                    <p class="text-capitalize">@Model.Weather[0].Description</p>
                    <p>Độ ẩm: @Model.Main.Humidity %</p>
                </div>
            </div>
        }
    </div>
</div>